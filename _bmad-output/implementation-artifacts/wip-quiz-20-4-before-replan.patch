@@ -0,0 +1,133 @@
+import { describeOptions, type NewOpenCheck, type PasskeyCapability, type SeedMethod, type SigningKind } from '@/lib/crypto/policy'
+import type { NetworkId } from '@/lib/xrpl/networks'
+
+/**
+ * What the create-wallet quiz does to the later answers when Network changes
+ * (FR-91, FR-65). Pure: it holds no state and decides no rule. Whether an answer
+ * is still legal is read from `describeOptions` for the new Network, so a rule
+ * that moves in `lib/crypto/policy.ts` moves here with it.
+ */
+
+/** The Signing Check a Network pre-selects: Standard off Mainnet, otherwise the
+ * passkey when this device can use one, else the App PIN. */
+export function defaultSigning(network: NetworkId, capability: PasskeyCapability): SigningKind {
+  if (network !== 'mainnet') return 'standard'
+  return capability === 'yes' ? 'passkey' : 'pin'
+}
+
+export interface Preselection {
+  seedMethod: SeedMethod
+  openCheck: NewOpenCheck
+  autoLockMinutes: number
+  signing: SigningKind
+}
+
+/** FR-60's pre-selected answers. The initial state and the reset share this. */
+export function preselection(network: NetworkId, capability: PasskeyCapability): Preselection {
+  return {
+    seedMethod: 'stored',
+    openCheck: capability === 'yes' ? 'passkey' : 'pin',
+    autoLockMinutes: 5,
+    signing: defaultSigning(network, capability),
+  }
+}
+
+/** The answers the Network can make illegal, plus the two flags that say how
+ * they were reached. */
+export interface NetworkAnswers {
+  seedMethod: SeedMethod
+  openCheck: NewOpenCheck
+  autoLockMinutes: number
+  signing: SigningKind
+  /** True once the person chose the Signing Check (or Passkey-Derived fixed it). */
+  signingTouched: boolean
+  nodeMode: 'builtin' | 'custom'
+}
+
+export interface NetworkContext {
+  capability: PasskeyCapability
+  origin: string | undefined
+  imported: boolean
+}
+
+/** One answer that was put back to its pre-selection, and what it is now. */
+export type ResetItem =
+  | { question: 'Node'; to: 'builtin' }
+  | { question: 'Seed Method'; to: SeedMethod }
+  | { question: 'Open Check'; to: NewOpenCheck }
+  | { question: 'Auto-lock'; to: number }
+  | { question: 'Signing Check'; to: SigningKind }
+
+export interface Reconciled {
+  answers: NetworkAnswers
+  /** Seed Method, Open Check, Auto-lock, Signing Check, then Node. Empty when nothing was reset. */
+  reset: ResetItem[]
+}
+
+/**
+ * Keeps every answer that is still legal on `nextNetwork`, puts each illegal one
+ * back to its pre-selection, and says which. A Signing Check the person never
+ * chose keeps following the Network's pre-selection and is not named: it was
+ * never an answer of theirs.
+ */
+export function reconcileForNetwork(answers: NetworkAnswers, nextNetwork: NetworkId, ctx: NetworkContext): Reconciled {
+  const pre = preselection(nextNetwork, ctx.capability)
+  const describe = (seedMethod: SeedMethod, openCheck: NewOpenCheck, autoLockMinutes: number, signing: SigningKind) =>
+    describeOptions({
+      network: nextNetwork,
+      seedMethod,
+      openCheck,
+      autoLockMinutes,
+      signing,
+      passkey: ctx.capability,
+      origin: ctx.origin,
+      canConfirmWrittenSeed: true,
+      ...(ctx.imported ? { imported: true } : {}),
+    })
+  const reset: ResetItem[] = []
+  const next: NetworkAnswers = { ...answers }
+
+  // Seed Method first: the Signing Check depends on it.
+  const first = describe(answers.seedMethod, answers.openCheck, answers.autoLockMinutes, answers.signing)
+  let seedFellBack = false
+  if (!first.seedMethod[answers.seedMethod].available) {
+    next.seedMethod = pre.seedMethod
+    seedFellBack = true
+    reset.push({ question: 'Seed Method', to: pre.seedMethod })
+  }
+  const second = describe(next.seedMethod, answers.openCheck, answers.autoLockMinutes, answers.signing)
+
+  if (!second.openCheck[answers.openCheck].available) {
+    next.openCheck = pre.openCheck
+    reset.push({ question: 'Open Check', to: pre.openCheck })
+  }
+  const lock = second.autoLock.find((c) => c.minutes === answers.autoLockMinutes)
+  if (!lock || !lock.available) {
+    next.autoLockMinutes = pre.autoLockMinutes
+    reset.push({ question: 'Auto-lock', to: pre.autoLockMinutes })
+  }
+
+  if (next.seedMethod === 'passkey-derived') {
+    // Its only Signing Check is its passkey (FR-67).
+    next.signing = 'passkey'
+    next.signingTouched = true
+  } else if (seedFellBack) {
+    next.signing = pre.signing
+    next.signingTouched = false
+    reset.push({ question: 'Signing Check', to: pre.signing })
+  } else if (!answers.signingTouched) {
+    next.signing = pre.signing
+  } else if (!second.signing[answers.signing].available) {
+    next.signing = pre.signing
+    next.signingTouched = false
+    reset.push({ question: 'Signing Check', to: pre.signing })
+  }
+
+  // A Node was proven for the network it was tested on, and only that one.
+  if (answers.nodeMode === 'custom') {
+    next.nodeMode = 'builtin'
+    reset.push({ question: 'Node', to: 'builtin' })
+  }
+
+  return { answers: next, reset }
+}
