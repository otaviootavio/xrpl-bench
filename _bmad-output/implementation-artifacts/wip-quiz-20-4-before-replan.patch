+  verifiedNode: null,
+  nodeReason: null,
+  nodeBusy: false,
+  seedMethod: 'passkey-derived',
+  passkeyChoice: 'new',
+  algorithm: 'ed25519',
+  openCheck: 'pin',
+  autoLockMinutes: 5,
+  signing: 'passkey',
+} as unknown as WalletQuestionsProps
+
+describe('the walk summarises every answer once', () => {
+  it('every registry entry yields at least one row tagged with its own step', () => {
+    for (const q of WALK_QUESTIONS) {
+      const rows = q.summary(PROPS)
+      expect(rows.length).toBeGreaterThan(0)
+      for (const row of rows) expect(row.step).toBe(q.id)
+    }
+  })
+
+  it('answerRows lists Label and Network first, then each walk question, with the Passkey row only when derived', () => {
+    expect(answerRows(PROPS).map((r) => [r.step, r.term])).toEqual([
+      ['name-network', 'Label'],
+      ['name-network', 'Network'],
+      ['node', 'Node'],
+      ['seed-method', 'Seed Method'],
+      ['seed-method', 'Passkey'],
+      ['signature-type', 'Signature type'],
+      ['open-check', 'Open Check'],
+      ['open-check', 'Auto-lock'],
+      ['signing-check', 'Signing Check'],
+    ])
+    expect(answerRows({ ...PROPS, seedMethod: 'stored' }).some((r) => r.term === 'Passkey')).toBe(false)
+  })
+
+  it('Import omits Seed Method, Passkey and Signature type', () => {
+    expect(answerRows({ ...PROPS, imported: true }).map((r) => r.term)).toEqual(['Label', 'Network', 'Node', 'Open Check', 'Auto-lock', 'Signing Check'])
+  })
+})
