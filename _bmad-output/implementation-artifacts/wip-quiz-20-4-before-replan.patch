+import type { describeOptions, NewOpenCheck, SeedMethod, SigningKind } from '@/lib/crypto/policy'
+import { NETWORKS, type NetworkId } from '@/lib/xrpl/networks'
+
+/** One formatter per answer. The step 2 list, the Review and the Network-change
+ * line all read them, so an answer is worded in exactly one place. */
+export const formatLabel = (label: string) => (normalizeWalletName(label) === '' ? 'Named automatically' : normalizeWalletName(label))
+export const formatNetwork = (network: NetworkId) => NETWORKS[network].label
+export const formatNode = (nodeMode: 'builtin' | 'custom', verifiedNode: string | null) =>
+  nodeMode === 'builtin' ? 'Built-in Nodes' : verifiedNode ? `${verifiedNode} (tested)` : 'Your own Node (not tested yet)'
+export const formatSeedMethod = (m: SeedMethod) => (m === 'stored' ? 'Stored Seed' : 'Passkey-Derived Seed')
+export const formatPasskeyChoice = (c: 'new' | 'existing') => (c === 'new' ? 'New passkey' : 'Existing passkey')
+export const formatAlgorithm = (a: 'ed25519' | 'secp256k1') => (a === 'ed25519' ? 'Ed25519' : 'secp256k1')
+export const formatOpenCheck = (c: NewOpenCheck) => (c === 'pin' ? 'App PIN' : c === 'passkey' ? 'Passkey' : 'No Open Check')
+export const formatAutoLock = minutesLabel
+export const formatSigning = (s: SigningKind) => (s === 'standard' ? 'Standard' : s === 'passkey' ? 'Passkey only' : 'App PIN only')
+
+/** The text for one reset: "Open Check is now App PIN". */
+export function formatReset(item: ResetItem): string {
+  const to =
+    item.question === 'Node'
+      ? formatNode(item.to, null)
+      : item.question === 'Seed Method'
+        ? formatSeedMethod(item.to)
+        : item.question === 'Open Check'
+          ? formatOpenCheck(item.to)
+          : item.question === 'Auto-lock'
+            ? formatAutoLock(item.to)
+            : formatSigning(item.to)
+  return `${item.question} is now ${to}`
+}
+
+/** The visible line under Network after a change that reset answers; null when none did. */
+export function resetLine(network: NetworkId, reset: readonly ResetItem[]): string | null {
+  if (reset.length === 0) return null
+  return `Changed to ${formatNetwork(network)}. Reset to the recommended answer: ${reset.map(formatReset).join('; ')}.`
+}
 
