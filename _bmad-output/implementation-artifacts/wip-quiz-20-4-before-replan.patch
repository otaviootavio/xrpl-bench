diff --git a/src/components/wallet/__tests__/network-reset.test.tsx b/src/components/wallet/__tests__/network-reset.test.tsx
new file mode 100644
index 0000000..74fd154
--- /dev/null
+++ b/src/components/wallet/__tests__/network-reset.test.tsx
@@ -0,0 +1,145 @@
+import { describe, expect, it } from 'vitest'
+import { AUTO_LOCK_CHOICES, describeOptions, type NewOpenCheck, type PasskeyCapability, type SeedMethod, type SigningKind } from '@/lib/crypto/policy'
+import { defaultSigning, preselection, reconcileForNetwork, type NetworkAnswers } from '@/components/wallet/network-reset'
+import type { NetworkId } from '@/lib/xrpl/networks'
+
+const NETWORKS: NetworkId[] = ['mainnet', 'testnet', 'devnet']
+const CAPABILITIES: PasskeyCapability[] = ['yes', 'no', 'unknown']
+const ORIGINS = ['localhost', 'sites-xrpl-bench-prod-pdbywc.b-cdn.net', undefined] // bound, temporary, unknown
+const SEEDS: SeedMethod[] = ['stored', 'passkey-derived']
+const OPEN: NewOpenCheck[] = ['pin', 'passkey', 'none']
+const SIGNING: SigningKind[] = ['standard', 'passkey', 'pin']
+
+const describe_ = (network: NetworkId, a: Pick<NetworkAnswers, 'seedMethod' | 'openCheck' | 'autoLockMinutes' | 'signing'>, capability: PasskeyCapability, origin: string | undefined, imported: boolean) =>
+  describeOptions({
+    network,
+    ...a,
+    passkey: capability,
+    origin,
+    canConfirmWrittenSeed: true,
+    ...(imported ? { imported: true } : {})
+  })
+
+describe('reconcileForNetwork', () => {
+  it('leaves no selected answer unavailable, and changes no answer that was available, for every combination', () => {
+    let cases = 0
+    for (const to of NETWORKS)
+      for (const capability of CAPABILITIES)
+        for (const origin of ORIGINS)
+          for (const imported of [false, true])
+            for (const seedMethod of SEEDS)
+              for (const openCheck of OPEN)
+                for (const autoLockMinutes of AUTO_LOCK_CHOICES)
+                  for (const signing of SIGNING)
+                    for (const signingTouched of [false, true]) {
+                      if (imported && seedMethod === 'passkey-derived') continue
+                      const answers: NetworkAnswers = {
+                        seedMethod,
+                        openCheck,
+                        autoLockMinutes,
+                        signing,
+                        signingTouched,
+                        nodeMode: 'builtin'
+                      }
+                      const { answers: next } = reconcileForNetwork(answers, to, { capability, origin, imported })
+                      const after = describe_(to, next, capability, origin, imported)
+                      expect(after.seedMethod[next.seedMethod].available).toBe(true)
+                      expect(after.openCheck[next.openCheck].available).toBe(true)
+                      expect(after.autoLock.find((c) => c.minutes === next.autoLockMinutes)?.available).toBe(true)
+                      expect(after.signing[next.signing].available).toBe(true)
+                      // What was legal on the new Network is kept.
+                      const before = describe_(to, answers, capability, origin, imported)
+                      if (before.seedMethod[seedMethod].available) expect(next.seedMethod).toBe(seedMethod)
+                      if (before.openCheck[openCheck].available) expect(next.openCheck).toBe(openCheck)
+                      if (before.autoLock.find((c) => c.minutes === autoLockMinutes)?.available) expect(next.autoLockMinutes).toBe(autoLockMinutes)
+                      // An untouched Signing Check follows the pre-selection; a chosen, legal one stays.
+                      if (next.seedMethod === 'stored' && signingTouched && before.signing[signing].available && seedMethod === 'stored') expect(next.signing).toBe(signing)
+                      if (!signingTouched && next.seedMethod === 'stored' && seedMethod === 'stored') expect(next.signing).toBe(defaultSigning(to, capability))
+                      cases++
+                    }
+    expect(cases).toBeGreaterThan(5000)
+  })
+
+  it('the golden example: Testnet answers on Mainnet', () => {
+    const { answers, reset } = reconcileForNetwork(
+      {
+        seedMethod: 'stored',
+        openCheck: 'none',
+        autoLockMinutes: 0.5,
+        signing: 'standard',
+        signingTouched: false,
+        nodeMode: 'custom'
+      },
+      'mainnet',
+      { capability: 'yes', origin: 'localhost', imported: false }
+    )
+    expect(answers).toMatchObject({
+      seedMethod: 'stored',
+      openCheck: 'passkey',
+      autoLockMinutes: 5,
+      signing: defaultSigning('mainnet', 'yes'),
+      nodeMode: 'builtin'
+    })
+    expect(reset.map((r) => r.question)).toEqual(['Open Check', 'Auto-lock', 'Node'])
+  })
+
+  it('Passkey-Derived on an unbound host falls back to Stored, and the Signing Check returns to its pre-selection, both named', () => {
+    const { answers, reset } = reconcileForNetwork(
+      {
+        seedMethod: 'passkey-derived',
+        openCheck: 'pin',
+        autoLockMinutes: 5,
+        signing: 'passkey',
+        signingTouched: true,
+        nodeMode: 'builtin'
+      },
+      'mainnet',
+      { capability: 'unknown', origin: 'x.b-cdn.net', imported: false }
+    )
+    expect(answers.seedMethod).toBe('stored')
+    expect(answers.signing).toBe('pin')
+    expect(answers.signingTouched).toBe(false)
+    expect(reset.map((r) => r.question)).toEqual(['Seed Method', 'Signing Check'])
+  })
+
+  it('Passkey-Derived on a bound host is kept with a touched passkey Signing Check', () => {
+    const { answers, reset } = reconcileForNetwork(
+      {
+        seedMethod: 'passkey-derived',
+        openCheck: 'pin',
+        autoLockMinutes: 5,
+        signing: 'passkey',
+        signingTouched: true,
+        nodeMode: 'builtin'
+      },
+      'mainnet',
+      { capability: 'yes', origin: 'localhost', imported: false }
+    )
+    expect(answers).toMatchObject({
+      seedMethod: 'passkey-derived',
+      signing: 'passkey',
+      signingTouched: true
+    })
+    expect(reset).toEqual([])
+  })
+
+  it('an untouched Signing Check follows the Network silently; nothing differing resets nothing', () => {
+    const pre = preselection('testnet', 'no')
+    const { answers, reset } = reconcileForNetwork({ ...pre, signingTouched: false, nodeMode: 'builtin' }, 'mainnet', { capability: 'no', origin: 'localhost', imported: false })
+    expect(answers.signing).toBe('pin')
+    expect(reset).toEqual([])
+  })
+
+  it('a built-in Node is not named', () => {
+    const { reset } = reconcileForNetwork(
+      {
+        ...preselection('testnet', 'no'),
+        signingTouched: false,
+        nodeMode: 'builtin'
+      },
+      'devnet',
+      { capability: 'no', origin: 'localhost', imported: false }
+    )
+    expect(reset).toEqual([])
+  })
+})
